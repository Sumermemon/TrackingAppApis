{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=RunningCompetitionDb;Username=postgres;Password=YourSecurePassword123;"
  },
  "Jwt": {
    "Secret": "YOUR-SUPER-SECRET-KEY-CHANGE-IN-PRODUCTION-MIN-32-CHARS!!",
    "Issuer": "RunningCompetitionAPI",
    "Audience": "RunningCompetitionApp",
    "AccessTokenExpiryMinutes": 15,
    "RefreshTokenExpiryDays": 7
  },
  "Email": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromEmail": "noreply@runningapp.com",
    "FromName": "Running Competition",
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "UseSsl": true
  },
  "Redis": {
    "ConnectionString": "localhost:6379",
    "InstanceName": "RunningApp:"
  },
  "Hangfire": {
    "WorkerCount": 5,
    "DashboardPath": "/hangfire"
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "RateLimit": {
    "PermitLimit": 100,
    "WindowSeconds": 60,
    "QueueLimit": 10
  },
  "AllowedHosts": "*"
}
